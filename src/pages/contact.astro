---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
---
<Layout
  title={`Contact | ${site.name}`}
  description="Get in touch with Cole Rowell-Love by email, LinkedIn, or GitHub."
  ogDescription="Email, LinkedIn, and GitHub."
>
  <section class="wrap page-head">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="summary">The best way to reach me is by email.</p>
    <ul class="contact-list">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.linkedin} target="_blank" rel="noopener">linkedin.com/in/colerowell</a></li>
      <li><a href={site.github} target="_blank" rel="noopener">github.com/ColeRowellLove</a></li>
    </ul>
  </section>
</Layout>
