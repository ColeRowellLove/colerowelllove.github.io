---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
---
<Layout title={`Page not found | ${site.name}`} description="This page does not exist." noindex>
  <section class="wrap page-head">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="summary">That page doesn't exist. Try the <a href="/">home page</a> or the <a href="/projects">projects</a>.</p>
  </section>
</Layout>
