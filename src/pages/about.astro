---
import Layout from '../layouts/Layout.astro';
import Entry from '../components/Entry.astro';
import { site, skills, education, interests } from '../data/site.js';
---
<Layout
  title={`About | ${site.name}`}
  description="About Cole Rowell-Love: Engineering Physics graduate of the University of British Columbia, with skills in Python, C++, PyTorch, and machine learning tooling, plus interests in fitness, music, and AI."
  ogDescription="Education, technical skills, and interests."
>
  <section class="wrap page-head">
    <p class="eyebrow">About</p>
    <h1>About me</h1>
    <p class="summary">I'm an Engineering Physics graduate of the University of British Columbia in Vancouver. I've worked on deep learning for medical imaging, evaluation and fine-tuning of large language models, and production computer vision, along with the software around them.</p>
  </section>

  <section class="wrap block" aria-labelledby="skills-h">
    <h2 id="skills-h">Skills</h2>
    <dl class="skills">
      {skills.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </section>

  <section class="wrap block" aria-labelledby="education-h">
    <h2 id="education-h">Education</h2>
    <div class="entries">
      <Entry {...education} />
    </div>
  </section>

  <section class="wrap block" aria-labelledby="interests-h">
    <h2 id="interests-h">Interests</h2>
    <dl class="skills">
      {interests.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </section>

  <section class="wrap block" aria-labelledby="elsewhere-h">
    <h2 id="elsewhere-h">Elsewhere</h2>
    <p class="more"><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a> · <a href={site.github} target="_blank" rel="noopener">GitHub</a> · <a href="/contact">Contact</a></p>
  </section>
</Layout>
