---
const {
  dates,
  place,
  title,
  org,
  orgUrl,
  lede,
  bullets = [],
  tags = [],
  note,
  link,
  links = [],
  heading = 'h3',
} = Astro.props;

const allLinks = links.length > 0 ? links : link ? [link] : [];
const dateLines = Array.isArray(dates) ? dates : [dates];
const Heading = heading;
const headingClass = heading === 'h2' ? 'entry-title' : undefined;
---

<article class="entry">
  <div class="entry-meta">
    <p class="dates">
      {dateLines.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </p>
    {place && <p class="place">{place}</p>}
  </div>
  <div class="entry-body">
    <Heading class={headingClass}>{title}</Heading>
    {org && (
      <p class="org">
        {orgUrl ? (
          <a href={orgUrl} target="_blank" rel="noopener">
            {org}
          </a>
        ) : (
          org
        )}
      </p>
    )}
    {note && <p class="note">{note}</p>}
    {lede && <p class="lede">{lede}</p>}
    {bullets.length > 0 && (
      <ul>
        {bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )}
    {tags.length > 0 && (
      <ul class="tags" aria-label="Topics">
        {tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )}
    {allLinks.length > 0 && (
      <p class="more">
        {allLinks.map((l, i) => (
          <>
            {i > 0 && ' · '}
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          </>
        ))}
      </p>
    )}
  </div>
</article>
