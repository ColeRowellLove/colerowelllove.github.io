---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import font400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import '../styles/global.css';
import { site, nav } from '../data/site.js';

const { title, description, ogDescription = description, noindex = false } = Astro.props;

const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/$/, '') || '/';
const canonical = site.url + (path === '/' ? '/' : path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {
        /* storage unavailable: follow the OS setting */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/">
          {site.name}
        </a>
        <nav aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" hidden>
          Light mode
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p>
        © <span id="year">{new Date().getFullYear()}</span> {site.name}
      </p>
    </footer>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
