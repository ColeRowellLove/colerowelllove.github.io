---
import '../styles/global.css';
import { site, nav } from '../data/site.js';

const { title, description, ogDescription = description, noindex = false } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = site.url + (path === '/' ? '/' : path);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content="light dark">
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  {!noindex && <meta property="og:url" content={canonical}>}
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap bar">
      <a class="wordmark" href="/">{site.name}</a>
      <nav aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="wrap site-footer">
    <p>© <span id="year">{new Date().getFullYear()}</span> {site.name}</p>
  </footer>
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
